import cv2

# Read the image
image = cv2.imread(r"C:\Users\bolla\Downloads\tree_image.jpg")

if image is None:
    raise FileNotFoundError("Could not load the image. Check the file path.")

# Resize to a bigger size (2×)
bigger_image = cv2.resize(
    image, None, fx=2, fy=2, interpolation=cv2.INTER_LINEAR
)

# Resize to a smaller size (0.5×)
smaller_image = cv2.resize(
    image, None, fx=0.5, fy=0.5, interpolation=cv2.INTER_AREA
)

# Display the images
cv2.imshow("Original Image", image)
cv2.imshow("Bigger Image", bigger_image)
cv2.imshow("Smaller Image", smaller_image)

# Wait for a key press, then close the windows
cv2.waitKey(0)
cv2.destroyAllWindows()
