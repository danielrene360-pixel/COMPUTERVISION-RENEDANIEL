
import cv2
import numpy as np

image = cv2.imread(r"C:\Users\bolla\Downloads\tree_image.jpg")

if image is None:
    raise FileNotFoundError("Could not load the image. Check the file path.")

# Keep a copy so the original remains unchanged
result = image.copy()

# Convert to grayscale and float32 for Harris Corner Detection
gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)
gray = np.float32(gray)

# Detect and make corners easier to see
harris_corners = cv2.cornerHarris(gray, blockSize=2, ksize=3, k=0.04)
harris_corners = cv2.dilate(harris_corners, None)

# Mark detected corners in red
result[harris_corners > 0.01 * harris_corners.max()] = [0, 0, 255]

cv2.imshow("Original Image", image)
cv2.imshow("Harris Corner Detection", result)

output_path = r"C:\Users\bolla\Downloads\harris_corners.jpg"
if not cv2.imwrite(output_path, result):
    raise OSError(f"Could not save the image to: {output_path}")

cv2.waitKey(0)
cv2.destroyAllWindows()
