import cv2
import numpy as np

image = cv2.imread(r"C:\Users\bolla\Downloads\tree_image.jpg")

if image is None:
    raise FileNotFoundError("Could not load the image. Check the file path.")

rows, cols, _ = image.shape

pts1 = np.float32([[50, 50], [200, 50], [50, 200]])
pts2 = np.float32([[10, 100], [200, 50], [100, 250]])

matrix = cv2.getAffineTransform(pts1, pts2)
transformed_image = cv2.warpAffine(image, matrix, (cols, rows))

cv2.imshow("Original Image", image)
cv2.imshow("Affine Transformed Image", transformed_image)

output_path = r"C:\Users\bolla\Downloads\affine_transformed.jpg"
if not cv2.imwrite(output_path, transformed_image):
    raise OSError(f"Could not save the image to: {output_path}")

cv2.waitKey(0)
cv2.destroyAllWindows()
